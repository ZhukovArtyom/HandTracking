{
  "name": "hand-tracking-ui",
  "version": "1.0.0",
  "description": "UI for Hand Tracking Application",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.handtracking.app",
    "productName": "Hand Tracking Control",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../backend/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
